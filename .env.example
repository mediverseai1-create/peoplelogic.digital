# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=

# Server-only secrets - never expose to the client
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Optional: override the Gemini model (default gemini-2.5-flash)
GEMINI_MODEL=

# External checkout links (server-side; opened via /api/billing/checkout)
PROFESSIONAL_PAYMENT_LINK=
ENTERPRISE_PAYMENT_LINK=

# Optional: JSON plan entitlements, e.g. {"professional":{"monthlyCredits":null},"enterprise":{"monthlyCredits":null}}
PLAN_ENTITLEMENTS=
# Optional: JSON credit cost per operation, e.g. {"ask":1,"report":2,"feedback_analysis":2,"scenario_explain":1}
CREDIT_COSTS=
